# Copy to .env and fill in, or export these in your shell / CI secrets.
# Get keys at https://app.alpaca.markets (use the PAPER keys first).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic API key for the Claude morning analyst (https://console.anthropic.com).
# Without it the deterministic rules-based analyst is used instead.
ANTHROPIC_API_KEY=

# Optional: Slack or Discord incoming-webhook URL for run summaries.
ALERT_WEBHOOK_URL=

# Live trading is OFF unless this is set to exactly: I_UNDERSTAND_THE_RISKS
# (and the CLI is also invoked with --live). Paper trading needs nothing here.
STOCK_AGENT_LIVE_TRADING=
